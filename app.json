{
  "expo": {
    "name": "IT-Markt Verzeichnis",
    "slug": "it-markt-verzeichnis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "itmarkt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.itmarkt.verzeichnis",
      "infoPlist": {
        "NSCameraUsageDescription": "Diese App benoetigt Zugriff auf die Kamera, um QR-Codes und Barcodes zu scannen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "de.itmarkt.verzeichnis",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1565C0",
          "dark": {
            "backgroundColor": "#0D47A1"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Diese App benoetigt Zugriff auf die Kamera, um QR-Codes und Barcodes zu scannen."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
